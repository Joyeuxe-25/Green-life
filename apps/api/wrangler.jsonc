{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "green-life-rwanda-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-06",
	"d1_databases": [
  {
    "binding": "DATABASE",
    "database_name": "green-life-rwanda",
    "database_id": "046b3ce2-c392-4e25-b6a5-4d8464b32cc8"
  }
],
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "green-life-rwanda-media"
		}
	],
	"vars": {
		"R2_PUBLIC_BASE_URL": "https://media.greenliferwanda.org"
	}
}