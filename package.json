{
  "name": "green-life-rwanda",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo foundation for the Green for Life Rwanda public site, admin site, API, and shared package.",
  "scripts": {
    "dev:public": "pnpm --filter public-site dev",
    "dev:admin": "pnpm --filter admin-site dev",
    "dev:api": "pnpm --filter api dev",
    "build:shared": "pnpm --filter @green-life-rwanda/shared build",
    "typecheck": "pnpm --recursive typecheck"
  },
  "packageManager": "pnpm@9.0.0"
}
